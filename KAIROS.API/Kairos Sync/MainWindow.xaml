<Window ResizeMode="CanMinimize" x:Class="Kairos_Sync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kairos_Sync"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"         
    Title="Kairos Sync" Height="489" Width="826">
    <Grid>
        <TabControl>
            <TabItem Header="Insere Cadastros">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="343*"/>
                        <ColumnDefinition Width="451*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Caminho Excel" HorizontalAlignment="Left" Margin="2,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox  x:Name="TxbCaminhoExcel" IsEnabled="False" MaxLines="1" HorizontalAlignment="Left" Margin="112,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="230" FontWeight="Bold" FontSize="14"/>
                    <Button x:Name="BtnCaminhoExcel" Content="..." HorizontalAlignment="Left" Margin="4,13,0,0" VerticalAlignment="Top" Width="48" FontWeight="Bold" FontSize="14" Grid.Column="1"/>
                    <Label Content="Key" HorizontalAlignment="Left" Margin="10,53,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.633,-0.228" FontWeight="Bold" FontSize="14"/>
                    <Label Content="CNP" HorizontalAlignment="Left" Margin="10,103,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.633,-0.228" FontWeight="Bold" FontSize="14"/>
                    <Label Content="CPF Resp." HorizontalAlignment="Left" Margin="10,165,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.633,-0.228" FontWeight="Bold" FontSize="14"/>
                    <TextBox x:Name="TxbKey" MaxLines="1" HorizontalAlignment="Left" Margin="59,61,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="185" FontWeight="Bold" FontSize="14"/>
                    <TextBox x:Name="TxbCNPJ" MaxLines="1" HorizontalAlignment="Left" Margin="59,111,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="185" FontWeight="Bold" FontSize="14"/>
                    <TextBox x:Name="TxbCPFResponsavel" MaxLines="1" HorizontalAlignment="Left" Margin="83,167,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="161" FontWeight="Bold" FontSize="14"/>
                    <Button Content="Lista Horarios" HorizontalAlignment="Left" Margin="262,59,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="129" FontSize="14" Grid.ColumnSpan="2"/>
                    <Button Content="Valida Dados" HorizontalAlignment="Left" Margin="262,109,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="129" FontSize="14" Grid.ColumnSpan="2"/>
                    <Button Content="Sync" HorizontalAlignment="Left" Margin="262,165,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="129" FontSize="14" Grid.ColumnSpan="2"/>
                    <GroupBox Header="Inserir" FontWeight="Bold" FontSize="14" Height="80" Margin="0,203,50,123">
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <CheckBox x:Name="CjkEstruturas" Content="Estruturas" Margin="5" FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="ChkCargos" Content="Cargos" Margin="5" FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="ChkPessoas" Content="Pessoas" Margin="5" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </GroupBox>
                    <Label Content="Validando Dados" HorizontalAlignment="Left" Margin="10,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <Label Content="Estruturas" HorizontalAlignment="Left" Margin="163,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <Label Content="Cargos" HorizontalAlignment="Left" Margin="276,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <Label Content="Horarios" HorizontalAlignment="Left" Margin="23,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Grid.Column="1"/>
                    <Label Content="Pessoas" HorizontalAlignment="Left" Margin="120,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Grid.Column="1"/>
                    <Image x:Name="ImgValidaDados" Source="/Spin.gif" HorizontalAlignment="Left" Height="25" Margin="134,302,0,0" VerticalAlignment="Top" Width="25" Stretch="Fill"/>
                    <Image x:Name="ImgEstruturas" Source="/Spin.gif" HorizontalAlignment="Left" Height="25" Margin="244,302,0,0" VerticalAlignment="Top" Width="25" RenderTransformOrigin="0.45,-1.596"/>
                    <Image x:Name="ImgCargos" Source="/Spin.gif" HorizontalAlignment="Left" Height="20" Margin="336,302,0,0" VerticalAlignment="Top" Width="25" Grid.ColumnSpan="2"/>
                    <Image x:Name="ImgHorarios" HorizontalAlignment="Left" Height="25" Margin="95,302,0,0" VerticalAlignment="Top" Width="25" Source="/check.png" Grid.Column="1"/>
                    <Image x:Name="ImgPessoas" Source="/Spin.gif" HorizontalAlignment="Left" Height="25" Margin="185,302,0,0" VerticalAlignment="Top" Width="25" RenderTransformOrigin="0.45,1.954" Grid.Column="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Insere Saldo">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="Insere Desligamento">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>

            <TabItem Header="Altera Pessoa">
                <Grid Background="#FFE5E5E5">
                    <Label Content="CNPJ" HorizontalAlignment="Left" Margin="6,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox MaxLines="1" HorizontalAlignment="Left" Margin="51,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="144" FontWeight="Bold" FontSize="14"/>
                    <Label Content="Chave" HorizontalAlignment="Left" Margin="202,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox MaxLines="1" HorizontalAlignment="Left" Margin="255,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="161" FontWeight="Bold" FontSize="14"/>
                    <Label Content="CPF Resp." HorizontalAlignment="Left" Margin="425,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox MaxLines="1" HorizontalAlignment="Left" Margin="501,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="110" FontWeight="Bold" FontSize="14"/>
                    <Button Content="Importar" HorizontalAlignment="Left" Margin="622,14,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="26" Width="68"/>
                    <Button Content="BKP Excel" HorizontalAlignment="Left" Margin="708,14,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="25" Width="73"/>
                    <Label Content="Camino Excel"   HorizontalAlignment="Left" Margin="6,52,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox IsEnabled="False" MaxLines="1" HorizontalAlignment="Left" Margin="108,56,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="144" FontWeight="Bold" FontSize="14"/>
                    <Button Content="---" HorizontalAlignment="Left" Margin="274,56,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="26" Width="40"/>
                    <Button Content="Atualizar Lista" HorizontalAlignment="Left" Margin="369,56,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="26" Width="129"/>
                    <GroupBox Header="Campo chave do funcionario" FontWeight="Bold" FontSize="14" Height="80" Margin="6,102,495,224" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <RadioButton x:Name="RbMatricula" Content="Matricula" Margin="5" FontWeight="Bold" FontSize="14"/>
                            <RadioButton x:Name="RBCPF" Content="CPF" Margin="5" FontWeight="Bold" FontSize="14"/>
                            <RadioButton x:Name="RBPIS" Content="Pessoas" Margin="5" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </GroupBox>
                    <Button Content="Iniciar" HorizontalAlignment="Center" Margin="0,119,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="40" Width="152"/>

                    <DataGrid
                  Margin="4,203,10,10"
                  ColumnWidth="SizeToHeader">">>

                        <DataGrid.Columns >

                            <DataGridTextColumn Binding="{Binding Matricula}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Matricula" Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Nome}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Nome        " Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding PIS}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="PIS" Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Cracha}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Cracha" Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding DataDeNascimento}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Data de Nascimento" Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding DataDeAdminisao}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Data de Admissão" Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding RG}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="RG     " Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding CPF}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="CPF     " Margin="0,0,5,0"/>
                                            <TextBlock Text=""/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Celular}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Celular" Margin="0,0,5,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Email}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="E-mail" Margin="0,0,5,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Deparamento}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Departamento" Margin="0,0,5,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Horario}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Horario" Margin="0,0,5,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Cargo}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Cargo" Margin="0,0,5,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Sexo}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Sexo   " Margin="0,0,5,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
