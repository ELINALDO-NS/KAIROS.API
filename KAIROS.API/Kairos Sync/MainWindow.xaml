<Window ResizeMode="CanMinimize" x:Class="Kairos_Sync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kairos_Sync"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"         
    Title="Kairos Sync" Height="490" Width="830">
    <Window.Resources>
        <local:ConverterSexo x:Key="ConverterSexo"/>

    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Insere Cadastros">
                <Grid Background="#FFE5E5E5">
                    <Label Content="Caminho Excel" HorizontalAlignment="Left" Margin="2,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="29" Width="106"/>
                    <TextBox Text="{Binding CaminhoExcel,UpdateSourceTrigger=PropertyChanged}" x:Name="TxbCaminhoExcel" IsEnabled="False" MaxLines="1" HorizontalAlignment="Left" Margin="112,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="255" FontWeight="Bold" FontSize="14" Height="21"/>
                    <Button x:Name="BtnCaminhoExcel" Content="..." Width="48" HorizontalAlignment="Left" Margin="372,14,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Click="BtnCaminhoExcel_Click_1"/>
                    <Label Content="Key" HorizontalAlignment="Left" Margin="10,53,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.633,-0.228" FontWeight="Bold" FontSize="14" Height="29" Width="34"/>
                    <Label Content="CNP" HorizontalAlignment="Left" Margin="10,103,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.633,-0.228" FontWeight="Bold" FontSize="14" Height="29" Width="38"/>
                    <Label Content="CPF Resp." HorizontalAlignment="Left" Margin="10,165,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.633,-0.228" FontWeight="Bold" FontSize="14" Height="29" Width="73"/>
                    <TextBox x:Name="TxbKey" MaxLines="1" HorizontalAlignment="Left" Margin="59,61,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="228" FontWeight="Bold" FontSize="14" Height="21"/>
                    <TextBox x:Name="TxbCNPJ" MaxLines="1" HorizontalAlignment="Left" Margin="59,111,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="228" FontWeight="Bold" FontSize="14" Height="21"/>
                    <TextBox x:Name="TxbCPFResponsavel" MaxLines="1" HorizontalAlignment="Left" Margin="83,167,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="204" FontWeight="Bold" FontSize="14" Height="21"/>
                    <Button x:Name="BtnListaHorarios" Content="Lista Horarios" HorizontalAlignment="Left" Margin="292,59,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="129" FontSize="14" Click="BtnListaHorarios_Click" Height="23" />
                    <Button x:Name="BtnValidaDados"  Content="Valida Dados" HorizontalAlignment="Left" Margin="294,109,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="129" FontSize="14" Click="BtnValidaDados_Click" Height="23"/>
                    <Button x:Name="BtnSync" Content="Sync" HorizontalAlignment="Left" Margin="294,165,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="129" FontSize="14" Click="BtnSync_Click" Height="23" />
                    <GroupBox Header="Inserir" FontWeight="Bold" FontSize="14" Margin="0,208,50,141">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <CheckBox x:Name="ChkEstruturas" Content="Estruturas" Margin="12" FontWeight="Bold" FontSize="14" Checked="ChkEstruturas_Checked" Unchecked="ChkEstruturas_UnChecked"/>
                            <CheckBox x:Name="ChkCargos" Content="Cargos" Margin="10" FontWeight="Bold" FontSize="14" Checked="ChkCargos_Checked" Unchecked="ChkCargos_Unchecked"/>
                            <CheckBox x:Name="ChkPessoas" Content="Pessoas" Margin="10" FontWeight="Bold" FontSize="14" Checked="ChkPessoas_Checked" Unchecked="ChkPessoas_Unchecked"/>
                        </StackPanel>
                    </GroupBox>
                    <Label Content="Validando Dados" HorizontalAlignment="Left" Margin="10,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="29" Width="121"/>
                    <Label Content="Estruturas" HorizontalAlignment="Left" Margin="163,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="29" Width="76"/>
                    <Label Content="Cargos" HorizontalAlignment="Left" Margin="366,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="29" Width="56"/>
                    <Label Content="Horarios" HorizontalAlignment="Left" Margin="267,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="29" Width="67"/>
                    <Label Content="Pessoas" HorizontalAlignment="Left" Margin="457,298,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="29" Width="60"/>
                    <Image x:Name="ImgValidaDados" Source="/Spin.gif" HorizontalAlignment="Left" Height="25" Margin="134,302,0,0" VerticalAlignment="Top" Width="25" Stretch="Fill"/>
                    <Image x:Name="ImgEstruturas" Source="/Spin.gif" HorizontalAlignment="Left" Height="25" Margin="244,302,0,0" VerticalAlignment="Top" Width="25" RenderTransformOrigin="0.45,-1.596"/>
                    <Image x:Name="ImgCargos" Source="/Spin.gif" HorizontalAlignment="Left" Height="20" Margin="336,302,0,0" VerticalAlignment="Top" Width="25"/>
                    <Image x:Name="ImgHorarios" HorizontalAlignment="Left" Height="25" Margin="426,302,0,0" VerticalAlignment="Top" Width="25" Source="/check.png"/>
                    <Image x:Name="ImgPessoas" Source="/Spin.gif" HorizontalAlignment="Left" Height="25" Margin="519,302,0,0" VerticalAlignment="Top" Width="24" RenderTransformOrigin="0.45,1.954"/>
                </Grid>
            </TabItem>
            <TabItem Header="Insere Saldo">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="Insere Desligamento">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>

            <TabItem Header="Altera Pessoa">

                <Grid Background="#FFE5E5E5">
                    <Label Content="CNPJ" HorizontalAlignment="Left" Margin="6,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox MaxLines="1" HorizontalAlignment="Left" Margin="51,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="144" FontWeight="Bold" FontSize="14"/>
                    <Label Content="Chave" HorizontalAlignment="Left" Margin="202,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox MaxLines="1" HorizontalAlignment="Left" Margin="255,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="161" FontWeight="Bold" FontSize="14"/>
                    <Label Content="CPF Resp." HorizontalAlignment="Left" Margin="425,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox MaxLines="1" HorizontalAlignment="Left" Margin="501,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="110" FontWeight="Bold" FontSize="14"/>
                    <Button Content="Importar" HorizontalAlignment="Left" Margin="622,14,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="26" Width="68"/>
                    <Button Content="BKP Excel" HorizontalAlignment="Left" Margin="708,14,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="25" Width="73"/>
                    <Label Content="Camino Excel"   HorizontalAlignment="Left" Margin="6,52,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                    <TextBox IsEnabled="False" MaxLines="1" HorizontalAlignment="Left" Margin="108,56,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="144" FontWeight="Bold" FontSize="14"/>
                    <Button Content="---" HorizontalAlignment="Left" Margin="274,56,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="26" Width="40"/>
                    <Button Content="Atualizar Lista" HorizontalAlignment="Left" Margin="369,56,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="26" Width="129"/>
                    <GroupBox Header="Campo chave do funcionario" FontWeight="Bold" FontSize="14" Height="80" Margin="6,102,495,224" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <RadioButton x:Name="RbMatricula" Content="Matricula" Margin="5" FontWeight="Bold" FontSize="14"/>
                            <RadioButton x:Name="RBCPF" Content="CPF" Margin="5" FontWeight="Bold" FontSize="14"/>
                            <RadioButton x:Name="RBPIS" Content="Pessoas" Margin="5" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </GroupBox>
                    <Button Content="Iniciar" HorizontalAlignment="Center" Margin="0,119,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Height="40" Width="152"/>
                    <ListView ScrollViewer.HorizontalScrollBarVisibility="Visible" Margin="0,203,0,0" ItemsSource="{Binding Pessoas}" FontWeight="Bold" FontSize="14" AlternationCount="2" >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="#F0F8FF" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, 
                                          Path=(ItemsControl.AlternationIndex)}"  Value="1">
                                        <Setter Property="Background" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>

                            <GridView>

                                <GridViewColumn DisplayMemberBinding="{Binding Matricula}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Matrícula"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Nome}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Nome" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding PIS}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="PIS         " Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Cracha}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Crachá        " Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding DataDeNascimento, StringFormat='dd/MM/yyyy'}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Data de Nascimento" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding DataDeAdminisao, StringFormat='dd/MM/yyyy'}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Data de Admissão" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding RG}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="RG               " Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Cpf}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="CPF             " Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Celular}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Celular" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Email}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="E-mail" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Departamento}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Departamento" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Horario}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Horário" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Cargo}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Cargo" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                                <GridViewColumn DisplayMemberBinding="{Binding Converter={StaticResource ConverterSexo},Path=Sexo }">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Sexo" Margin="0,0,5,0"/>
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>

                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

            </TabItem>

        </TabControl>

    </Grid>
</Window>
